[Unit]
Description=PigCloud TEE File Scanner Socket

[Socket]
ListenStream=/run/pigcloud-tee/scanner.sock
RuntimeDirectory=pigcloud-tee
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
SocketUser=pigcloud-tee
SocketGroup=www-data
SocketMode=0660
Backlog=256
RemoveOnStop=true

[Install]
WantedBy=sockets.target
